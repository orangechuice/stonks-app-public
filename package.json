{
  "name": "stonks-app",
  "private": true,
  "version": "1.0.5",
  "license": "MIT",
  "author": "orangechuice",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orangechuice/stonks-app-public.git"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"fs.rmSync('dist', {recursive: true, force: true}); fs.rmSync('dist_electron', {recursive: true, force: true})\"",
    "build": "npm run clean && tsc && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "test": "vitest run",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run clean && tsc && vite build && electron-builder --mac",
    "android:sync": "npm run build && cap sync android",
    "android:build:test": "npm run build && cap sync android && cd android && ./gradlew assembleDebug && cd .. && cp android/app/build/outputs/apk/debug/app-debug.apk ./stonks-test.apk",
    "android:build": "npm run build && cap sync android && cd android && ./gradlew assembleRelease && cd .. && cp android/app/build/outputs/apk/release/app-release.apk ./Stonks.apk",
    "android:install:test": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:install": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "android:run": "npm run build && cap sync android && cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/status-bar": "^8.0.3",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3",
    "gh-pages": "^6.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vitest": "^4.1.10",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.orangechuice.stonksapp",
    "productName": "Stonks",
    "publish": {
      "provider": "github",
      "owner": "orangechuice",
      "repo": "stonks-app-public"
    },
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    }
  }
}
